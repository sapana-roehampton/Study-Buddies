doctype html
html
  head
    title User Profile
    link(rel="stylesheet", href="/style.css")

  body

    div.navbar
      a(href="/") Home
      a(href="/users") Users
      a(href="/listings") Listings

    div.container

      h1 User Profile

      div.listing-card
        p
          strong Name:
          | #{user.name}

        p
          strong Email:
          | #{user.email}

        p
          strong Course:
          | #{user.course}

      br
      a(href="/users") ← Back to Users