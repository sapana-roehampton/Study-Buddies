extends layout

block content
  section.hero.users-hero
    div.hero-text
      p.badge Student Profile
      h1 #{user.name}
      p #{user.course}

  div.study-card.profile-card
    div.avatar-circle.large #{user.name.charAt(0)}

    h2 #{user.name}

    p
      strong Email:
      |  #{user.email}

    p
      strong Course:
      |  #{user.course}

    a.cta-button(href="/users") ← Back to Users