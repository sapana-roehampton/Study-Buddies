doctype html
html
  head
    title Study Buddies
    link(rel="stylesheet", href="/style.css")

  body
    div.navbar
      a(href="/listings") Listings
      a(href="/users") Users
      a(href="/listings/new") New Listing

    if loggedInUser
      a(href=`/users/${loggedInUser.id}`) #{loggedInUser.name}
      a(href="/logout") Logout
    else
      a(href="/login") Login

    .container
      block content