extends layout

block content
  section.hero.users-hero
    div.hero-text
      p.badge Study Community
      h1 Meet your Study Buddies
      p Browse students, view their profiles, and find classmates who share your course interests.

  h2.section-title Student Members

  div.card-grid
    each user in users
      div.study-card.user-card
        div.avatar-circle #{user.name.charAt(0)}

        h3
          a(href=`/users/${user.id}`) #{user.name}

        p.description #{user.course}

        div.card-footer
          p
            strong Email:
            |  #{user.email}

          a.edit-btn(href=`/users/${user.id}`) View Profile