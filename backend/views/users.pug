doctype html
html
  head
    title Users
    link(rel="stylesheet", href="/style.css")

  body

    div.navbar
      a(href="/") Home
      a(href="/users") Users
      a(href="/listings") Listings

    div.container

      h1 Study Buddies Users

      p Total Users: #{users.length}

      each user in users
        div.listing-card
          p
            strong Name:
            a(href=`/users/${user.id}`) #{user.name}

          p
            strong Email:
            | #{user.email}

          p
            strong Course:
            | #{user.course}