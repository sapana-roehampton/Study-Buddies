extends layout

block content
  section.hero
    div.hero-text
      p.badge Create Study Group
      h1 Start a new study listing
      p Add a study topic, choose a category, and help students find support.

  div.study-card.form-card
    form(action="/listings", method="POST")
      label Title
      input(type="text", name="title", placeholder="e.g. JavaScript Revision Group", required)

      label Description
      textarea(name="description", rows="5", placeholder="Describe what you need help with...", required)

      label Category
      input(type="text", name="category", placeholder="e.g. Web Development", required)

      label User ID
      input(type="number", name="user_id", placeholder="Enter your user ID", required)

      button(type="submit") Create Listing