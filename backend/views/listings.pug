extends layout

block content
  section.hero
    div.hero-text
    p.badge Study Buddies App
    h1 Find students to study with
    p Connect with classmates, join study groups, and get help with coursework.
    a.cta-button(href="/listings/new") + Create New Listing

  form.search-form(action="/listings", method="GET")
    input(type="text", name="search", placeholder="Search study groups...", value=search)
    button(type="submit") Search

  h2.section-title Available Study Groups

  div.card-grid
    each listing in listings
      div.study-card

        span.category-badge #{listing.category}

        h3
          a(href=`/listings/${listing.id}`) #{listing.title}

        p.description #{listing.description}

        div.card-footer
          p
            strong Posted by:
            |  #{listing.name}

          div.actions
            a.edit-btn(href=`/listings/${listing.id}/edit`) Edit

            form(action=`/listings/${listing.id}/delete`, method="POST")
              button.delete-btn(type="submit") Delete