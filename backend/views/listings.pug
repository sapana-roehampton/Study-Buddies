extends layout

block content

      h1 Study Buddies Listings

      each listing in listings
        div.listing-card

          p
            strong Title:
            a(href=`/listings/${listing.id}`) #{listing.title}

          p
            strong Description:
            | #{listing.description}

          p
            strong Created by:
            | #{listing.name}

          p
            strong Category:
            | #{listing.category}

          p
            a(href=`/listings/${listing.id}/edit`) Edit

          form(action=`/listings/${listing.id}/delete`, method="POST")
            button(type="submit") Delete