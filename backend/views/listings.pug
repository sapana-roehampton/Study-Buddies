doctype html
html
  head
    title Study Buddies Listings
    link(rel="stylesheet", href="/style.css")

  body

    div.navbar
      a(href="/") Home
      a(href="/users") Users
      a(href="/listings") Listings

    div.container

      h1 Study Buddies Listings

      each listing in listings
        div.listing-card

          p
            strong Title:
            a(href=`/listings/${listing.id}`) #{listing.title}

          p
            strong Description:
            | #{listing.description}

          p
            strong Created by:
            | #{listing.name}

          p
            strong Category:
            | Study Group   