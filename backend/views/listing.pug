extends layout

block content
  section.hero
    div.hero-text
      p.badge Listing Details
      h1 #{listing.title}
      p #{listing.category}

  div.study-card.profile-card
    span.category-badge #{listing.category}

    h2 #{listing.title}

    p.description #{listing.description}

    div.card-footer
      p
        strong Created by:
        |  #{listing.name}

      div.actions
        a.edit-btn(href=`/listings/${listing.id}/edit`) Edit Listing
        a.cta-button(href="/listings") ← Back to Listings

    if related && related.length
      h2.section-title Related Study Groups
      div.card-grid
        each item in related
          div.study-card
            span.category-badge #{item.category}
            h3
              a(href=`/listings/${item.id}`) #{item.title}
            p.description #{item.description}