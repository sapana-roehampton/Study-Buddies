extends layout

block content
  section.hero
    div.hero-text
      p.badge Listing Details
      h1 #{listing.title}
      p #{listing.category}

  div.study-card.profile-card
    span.category-badge #{listing.category}

    h2 #{listing.title}

    p.description #{listing.description}

    if ratingCount > 0
      p.rating-text #{Number(averageRating).toFixed(1)} / 5 (#{ratingCount} ratings)
    else
      p.rating-text No ratings yet

    if loggedInUser
      form.rating-form(action=`/listings/${listing.id}/rate`, method="POST")
        label Rate this listing
        select(name="rating", required)
          option(value="") Choose rating
          option(value="1") 1
          option(value="2") 2
          option(value="3") 3
          option(value="4") 4
          option(value="5") 5
        button(type="submit") Submit Rating
    else
      p
        a(href="/login") Login to rate this listing

    div.card-footer
      p
        strong Created by:
        |  #{listing.name}

      div.actions
        a.edit-btn(href=`/listings/${listing.id}/edit`) Edit Listing
        a.cta-button(href="/listings") ← Back to Listings
        
    div.study-card
    h2.section-title Messages

    if loggedInUser
      form.message-form(action=`/listings/${listing.id}/messages`, method="POST")
        label Send a message about this listing
        textarea(name="content", placeholder="Write your message...", required)
        button(type="submit") Send Message
    else
      p
        a(href="/login") Login to send a message

    if messages && messages.length
      each message in messages
        div.message-box
          p
            strong #{message.name}
            |  said:
          p #{message.content}
    else
      p No messages yet

    if related && related.length
      h2.section-title Related Study Groups
      div.card-grid
        each item in related
          div.study-card
            span.category-badge #{item.category}
            h3
              a(href=`/listings/${item.id}`) #{item.title}
            p.description #{item.description}